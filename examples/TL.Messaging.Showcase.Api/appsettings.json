{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "amq.topic",
    "ExchangeType": "topic",
    "RetryCount": 3,
    "PrefetchCount": 10
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "messaging-showcase-group",
    "DefaultTopic": "events.orders.v1",
    "AutoOffsetReset": "Earliest",
    "EnableIdempotence": true,
    "RetryCount": 3
  }
}
